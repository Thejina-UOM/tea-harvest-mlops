# Streamlit front end. It loads the committed model file and can optionally call the
# live API (set API_URL) for predictions.
FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 appuser
WORKDIR /app
COPY frontend/requirements.txt frontend/requirements.txt
RUN pip install --no-cache-dir -r frontend/requirements.txt
COPY src/__init__.py src/features.py src/
COPY frontend/ frontend/
COPY models/tea_harvest_ebm.joblib models/model_card.json models/
COPY reports/metrics/ reports/metrics/
COPY reports/figures/ reports/figures/
COPY data/raw/sri_lanka_tea_tri_gov_ds.csv data/raw/
ENV PYTHONUNBUFFERED=1
USER appuser
EXPOSE 8501
HEALTHCHECK CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8501/_stcore/health')"
CMD ["streamlit", "run", "frontend/streamlit_app.py", "--server.port=8501", "--server.address=0.0.0.0", "--server.headless=true"]
